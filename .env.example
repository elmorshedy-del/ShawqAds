# Required for Meta fetch
SHAWQ_META_ACCESS_TOKEN=
SHAWQ_META_AD_ACCOUNT_ID=1026963365133388
META_GRAPH_VERSION=v20.0

# Required for Shopify fetch
SHAWQ_SHOPIFY_ACCESS_TOKEN=
SHAWQ_SHOPIFY_STORE=f3e7e9-2.myshopify.com
SHOPIFY_API_VERSION=2025-10

# Optional date windows
BACKFILL_START_DATE=2026-06-03
SINCE=
UNTIL=
SHOPIFY_SINCE=
SHOPIFY_UNTIL=
META_SINCE=
META_UNTIL=
SHOPIFY_REPORTING_TIMEZONE=
META_REPORTING_TIMEZONE=

# Optional server refresh endpoint auth
REFRESH_API_KEY=
REFRESH_ON_START=true

# Optional session-event ingest protection.
# If set, append ?key=VALUE in the Shopify custom pixel endpoint.
SESSION_EVENT_INGEST_KEY=
SESSION_EVENTS_PATH=

# Live orders map
# Shopify webhook signing secret for orders/create. Required to accept webhooks;
# the HMAC is validated against the raw body before anything is parsed or stored.
SHOPIFY_WEBHOOK_SECRET=
# Optional server-side geocoder for cities not in the built-in table.
# Set GEOCODER_PROVIDER to mapbox | opencage | google (auto-detected from the
# matching key if omitted). Keys stay server-side and are never sent to the browser.
GEOCODER_PROVIDER=
MAPBOX_GEOCODING_TOKEN=
OPENCAGE_API_KEY=
GOOGLE_GEOCODING_API_KEY=
# Geocoder request timeout in ms (default 4000).
GEOCODER_TIMEOUT_MS=
# Optional override paths for the on-disk caches (default ./data/*.json).
LOCATION_CACHE_PATH=
ORDERS_MAP_STORE_PATH=
